      }
    },
    {
      "id": "symbol:.graphflow/skills/graphflow/SKILL.md:93e14384",
      "type": "Symbol",
      "content": "chunk chunk: Skill Insights (learning flywheel) (exported) @.graphflow/skills/graphflow/SKILL.md:433",
      "metadata": {
        "name": "chunk: Skill Insights (learning flywheel)",
