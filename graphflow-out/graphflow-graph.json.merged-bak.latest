      }
    },
    {
      "id": "symbol:.graphflow/skills/graphflow/SKILL.md:b76460b",
      "type": "Symbol",
      "content": "chunk chunk: Export Artifact (exported) @.graphflow/skills/graphflow/SKILL.md:413",
