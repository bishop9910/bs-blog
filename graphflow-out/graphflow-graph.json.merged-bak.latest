      }
    },
    {
      "id": "symbol:.graphflow/skills/graphflow/SKILL.md:abecd1f",
      "type": "Symbol",
      "content": "chunk chunk: Collaboration & Insights Tools (Low Frequency) (exported) @.graphflow/skills/graphflow/SKILL.md:175",
