      }
    },
    {
      "id": "symbol:.graphflow/skills/graphflow/SKILL.md:585322fe",
      "type": "Symbol",
      "content": "chunk chunk: Token Savings Stats (exported) @.graphflow/skills/graphflow/SKILL.md:441",
      "metadata": {
        "name": "chunk: Token Savings Stats",
        "kind": "chunk",
        "exported": true,
        "line": 441,
        "file": ".graphflow/skills/graphflow/SKILL.md",
