*.tsbuildinfo

.eslintcache

# Cypress
/cypress/videos/
/cypress/screenshots/

# Vitest
__screenshots__/

# Vite
*.timestamp-*-*.mjs

# Go backend: local build/scratch areas and runtime data.
# These live inside the workspace so the Go toolchain never needs to write to
# the user profile (which is what makes offline builds work here at all).
.gocache/
.gotmp/
.smoke/
.smokeweb/
.smokeprod/
.smokedev/
backend/data/
*.exe

# The frontend staged for embedding is a build artifact; only .gitkeep is
# tracked. The directory has to be re-included before its contents can be
# excluded again, because git never descends into an excluded directory -- and
# the general `dist` rule above already excludes this one.
!backend/internal/web/dist/
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# Assembled single-executable release folder.
backend/release/

# Windows build resources. winres/versioninfo.json and winres/icon.ico are
# hand-managed sources, not generated output: the icon is tracked on purpose so
# that dropping your own artwork there sticks. tools/icongen only fills in a
# missing one, and goversioninfo compiles the pair into the .syso objects Go
# links into the executable -- which is why they land in cmd/server/, and why
# their resource_windows_* names matter: that token keeps a leftover Windows
# resource object out of a Linux link.
backend/winres/icon.png
backend/cmd/server/*.syso

.claude/
.trae/
.vscode/

graphflow-out/
.graphflow/
.graphflow-cache/