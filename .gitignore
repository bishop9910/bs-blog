# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo

.eslintcache

# Cypress
/cypress/videos/
/cypress/screenshots/

# Vitest
__screenshots__/

# Vite
*.timestamp-*-*.mjs

# Go backend: local build/scratch areas and runtime data.
# These live inside the workspace so the Go toolchain never needs to write to
# the user profile (which is what makes offline builds work here at all).
.gocache/
.gotmp/
.smoke/
.smokeweb/
.smokeprod/
.smokedev/
backend/data/
*.exe

# The frontend staged for embedding is a build artifact; only .gitkeep is
# tracked. The directory has to be re-included before its contents can be
# excluded again, because git never descends into an excluded directory -- and
# the general `dist` rule above already excludes this one.
!backend/internal/web/dist/
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# Assembled single-executable release folder.
backend/release/
